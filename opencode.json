{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "qe-runtime-gated",
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env.example": "allow",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/.netrc": "deny",
      "**/credentials.json": "deny"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny"
    },
    "external_directory": {
      "*": "ask"
    },
    "task": {
      "*": "deny"
    },
    "skill": {
      "*": "deny",
      "qe-nano4-automation": "allow",
      "qe-nano4-bounded-phase-executor": "allow"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "python3 scripts/qe_runctl.py submit*": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git restore*": "deny",
      "git checkout*": "deny",
      "git branch -D*": "deny",
      "git branch -d*": "deny",
      "rm -rf*": "deny",
      "rm -r *": "deny",
      "sbatch": "deny",
      "sbatch *": "deny",
      "*/sbatch": "deny",
      "*/sbatch *": "deny",
      "srun": "deny",
      "srun *": "deny",
      "*/srun": "deny",
      "*/srun *": "deny",
      "salloc": "deny",
      "salloc *": "deny",
      "*/salloc": "deny",
      "*/salloc *": "deny",
      "mpirun": "deny",
      "mpirun *": "deny",
      "*/mpirun": "deny",
      "*/mpirun *": "deny",
      "mpiexec": "deny",
      "mpiexec *": "deny",
      "*/mpiexec": "deny",
      "*/mpiexec *": "deny",
      "pw.x": "deny",
      "pw.x *": "deny",
      "*/pw.x": "deny",
      "*/pw.x *": "deny",
      "bash -lc *sbatch*": "deny",
      "sh -c *sbatch*": "deny",
      "env * sbatch*": "deny"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny"
        },
        "external_directory": {
          "*": "deny"
        },
        "edit": {
          "*": "ask",
          "opencode.json": "deny",
          "*/opencode.json": "deny",
          ".opencode/agents/**": "deny",
          "*/.opencode/agents/**": "deny",
          ".opencode/skills/**": "deny",
          "*/.opencode/skills/**": "deny"
        },
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "pwd *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "sed -n *": "allow",
          "awk *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "readlink *": "allow",
          "realpath *": "allow",
          "sha256sum *": "allow",
          "bash -n *": "allow",
          "python3 -m py_compile *": "allow",
          "python3 -m compileall *": "allow",
          "python3 -m unittest*": "allow",
          "python3 scripts/qe_runctl.py validate*": "allow",
          "python3 scripts/qe_runctl.py render*": "allow",
          "python3 scripts/qe_runctl.py dry-run*": "allow",
          "python3 scripts/qe_runctl.py parse*": "allow",
          "python3 scripts/qe_runctl.py summarize*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git branch --show-current*": "allow",
          "opencode debug config*": "allow",
          "opencode agent list*": "allow"
        }
      }
    }
  }
}
