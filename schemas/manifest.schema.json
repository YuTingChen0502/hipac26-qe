{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hipac26 QE approved run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "autonomy_level",
    "benchmark_valid",
    "approved_by_human",
    "allowed_submit",
    "max_retries",
    "jobs"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "trial_id": {"type": "string", "pattern": "^[A-Z0-9]+-T[0-9]{3}$"},
    "autonomy_level": {"type": "string", "enum": ["L1", "L2", "L3", "L4"]},
    "benchmark_valid": {"const": false},
    "approved_by_human": {"type": "boolean"},
    "allowed_submit": {"type": "boolean"},
    "max_retries": {"type": "integer", "const": 0},
    "run_root": {"type": "string"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "config_id",
          "run_dir",
          "binary_path",
          "binary_sha256",
          "input_path",
          "input_sha256",
          "pseudo_paths",
          "pseudo_sha256",
          "slurm",
          "runtime"
        ],
        "properties": {
          "config_id": {"type": "string", "pattern": "^cfg[0-9]{3}[_A-Za-z0-9-]*$"},
          "run_dir": {"type": "string"},
          "binary_path": {"type": "string"},
          "binary_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "input_path": {"type": "string"},
          "input_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "pseudo_paths": {"type": "array", "items": {"type": "string"}},
          "pseudo_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}},
          "slurm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["account", "partition", "nodes", "ntasks", "cpus_per_task", "gres", "time"],
            "properties": {
              "account": {"type": "string"},
              "partition": {"type": "string"},
              "nodes": {"type": "integer", "minimum": 1, "maximum": 1},
              "ntasks": {"type": "integer", "minimum": 1, "maximum": 8},
              "cpus_per_task": {"type": "integer", "minimum": 1, "maximum": 16},
              "gres": {"type": "string"},
              "time": {"type": "string"}
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["omp_num_threads", "npools"],
            "properties": {
              "omp_num_threads": {"type": "integer", "minimum": 1, "maximum": 16},
              "npools": {"type": "integer", "minimum": 1, "maximum": 8},
              "extra_args": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
